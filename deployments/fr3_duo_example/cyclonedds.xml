<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS
  xmlns="https://cdds.io/config"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd"
>
  <Domain Id="any">
    <General>
      <!--
      Limiting to localhost communication, since all nodes are expected to run on the same machine.
      If this is not the case, change the address to the IP address of the host on the desired interface.
      https://cyclonedds.io/docs/cyclonedds/latest/config/network_interfaces.html

      Multicast is recommended for discovery: https://cyclonedds.io/docs/cyclonedds/latest/config/multicasting.html
      Linux loopback supports multicast but does not set IFF_MULTICAST, which Cyclone checks, so force it here.
       -->
      <Interfaces>
        <NetworkInterface autodetermine="false" address="127.0.0.1" multicast="true"/>
      </Interfaces>
      <!--
      Limit multicast to participant discovery, so user data (e.g. expensive camera frames) stays unicast.
       -->
      <AllowMulticast>spdp</AllowMulticast>
      <!-- https://www.stereolabs.com/docs/ros2/dds-and-network-tuning -->
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Internal>
      <!-- https://www.stereolabs.com/docs/ros2/dds-and-network-tuning -->
      <SocketReceiveBufferSize min="10MB" />
    </Internal>
  </Domain>
</CycloneDDS>
